EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Public token restricted to the app's bundle id / package name in the Mapbox dashboard.
EXPO_PUBLIC_MAPBOX_TOKEN=
EXPO_PUBLIC_SHARE_BASE_URL=https://wave.app
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Mapbox no longer requires a download token for the native SDK.
# Your own App ID registered at developer.apple.com (must match Xcode signing and Supabase's Apple client IDs)
WAVE_IOS_BUNDLE_ID=
