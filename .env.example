# Copy to .env.local (web) / .env (mobile). Never commit real values.

# Public — safe to ship to clients (restrict the Mapbox token by URL / bundle id)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_MAPBOX_TOKEN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_SHARE_BASE_URL=https://wave.app

# Server only — set with `supabase secrets set`, never in client bundles
# SUPABASE_SERVICE_ROLE_KEY=
# MAPBOX_SECRET_TOKEN=

# Supabase Auth providers (local `supabase start` / dashboard in production)
# SUPABASE_AUTH_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_GOOGLE_SECRET=
# SUPABASE_AUTH_APPLE_CLIENT_ID=
# SUPABASE_AUTH_APPLE_SECRET=
